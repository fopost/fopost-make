{
	"url": "/media/upload",
	"method": "POST",
	"type": "multipart/form-data",
	"body": {
		"workspaceId": "{{parameters.workspaceId}}",
		"files": {
			"value": "{{parameters.file_data}}",
			"options": {
				"filename": "{{parameters.file_name}}"
			}
		}
	},
	"response": {
		"output": "{{body.data[1]}}"
	}
}
